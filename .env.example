# One env file for every app. `findplate create` writes .env from this, with secrets generated.

# --- urls -------------------------------------------------------------------
# Where the Next servers reach the api (inside docker/dokploy: the api service url).
API_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
WEB_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3002
DOCS_URL=http://localhost:3003
# Optional: comma separated chrome-extension://<id> origins allowed to call the api with a token (unset: any extension)
# EXTENSION_ORIGINS=

# --- database ---------------------------------------------------------------
# Host port for the local docker postgres (pnpm db:up)
POSTGRES_PORT=5432
DATABASE_URL=postgres://skiffr:skiffr@localhost:5432/skiffr
# demo = seed an empty database with realistic data; none = never
SEED=demo

# --- auth (better-auth) -----------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# First admin, created or reset on every api start
ADMIN_EMAIL=admin@skiffr.local
ADMIN_PASSWORD=
# Optional: GitHub sign-in (callback: <DASHBOARD_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- landing page -----------------------------------------------------------
# owner/name, shows stars in the footer
GITHUB_REPO=
GITHUB_TOKEN=





# --- storage (any S3 API: Garage, R2, AWS, MinIO) ---------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# --- gmail job-email import (optional) --------------------------------------
# Needs a Google Cloud OAuth client, see the gmail page of the docs. All three or none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32. Seals the stored refresh tokens: losing it means reconnecting Gmail.
GMAIL_ENCRYPTION_KEY=
# Default <DASHBOARD_URL>/api/gmail/callback, the redirect uri to register in the Google client
# GOOGLE_REDIRECT_URI=
# How often the api reads mail (jittered), default 15
# GMAIL_SYNC_INTERVAL_MINUTES=15
# off: the api never reads mail itself, run "bun src/gmail-sync-cli.ts" from apps/api as a scheduled job instead
# GMAIL_SCHEDULER=on

# --- job source watcher ------------------------------------------------------
# off: the api never fetches watched careers pages and feeds itself ("Run now" still works)
# WATCH_SCHEDULER=on
# Minutes a source waits between fetches (15 to 1440)
# WATCH_REFRESH_MINUTES=60


# --- cv tailoring with Reactive Resume (optional) ---------------------------
# 32 random bytes, base64: openssl rand -base64 32. Seals the stored Reactive Resume api keys: losing it means entering them again.
CV_ENCRYPTION_KEY=


# --- ai (Vercel AI SDK) -----------------------------------------------------
# provider:model, provider = groq | openai | anthropic
AI_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model requests (chat and embeddings) and tokens one user may spend per UTC day, all replicas together. 0 = no limit
AI_DAILY_CALLS=600
AI_DAILY_TOKENS=1000000
# Model requests the whole server may make per UTC day, all users together. 0 = no limit
AI_GLOBAL_DAILY_CALLS=0

# --- observability (all optional, off when unset, see the observability page of the docs) ---
# GlitchTip / Sentry dsn: error class, stack and ids only
# GLITCHTIP_DSN=
# OTLP/HTTP base up to the org (OpenObserve: http://openobserve:5080/api/default). Request logs, metrics, model call spans
# OTEL_EXPORTER_OTLP_ENDPOINT=
# key=value,key=value, a secret: authorization=Basic <base64 email:password>,stream-name=skiffr
# OTEL_EXPORTER_OTLP_HEADERS=
# Umami page analytics for web, docs, dashboard (read at runtime) and api events: one website id per app
# UMAMI_URL=
# UMAMI_WEBSITE_ID=
# true adds prompts and answers to model call spans. They hold personal data: leave it off
# AI_TRACE_CAPTURE_CONTENT=false

# --- client address (sign-in rate limits) ------------------------------------
# Header the proxy in front of the api sets, and how many proxies append to it. 0 ignores the header
# CLIENT_IP_HEADER=x-forwarded-for
# TRUSTED_PROXY_COUNT=1






# --- turbo remote cache (optional) ------------------------------------------
TURBO_API=
TURBO_TEAM=
TURBO_TOKEN=

# --- playground (apps/playground, optional) ----------------------------------
# Public address of the index host. Pages answer on <site>.<this host> when PLAYGROUND_SUBDOMAINS is true (needs a wildcard name), on /s/<site> otherwise
# PLAYGROUND_URL=http://playground.localhost:3004
# PLAYGROUND_SUBDOMAINS=true
# Required on a public or production server: without it /inspect, /admin and the submissions listing answer 403.
# Sent as the x-playground-token header, or once as ?token= which swaps it for a cookie
# PLAYGROUND_TOKEN=
# Bytes a request body may have, and the per address write limit (burst, then per minute; burst 0 turns it off)
# PLAYGROUND_MAX_BODY=1000000
# PLAYGROUND_RATE_BURST=20
# PLAYGROUND_RATE_PER_MINUTE=30
# Proxies in front that append to x-forwarded-for (1 behind Traefik), 0 ignores the header
# TRUSTED_PROXY_COUNT=0
# Extra logins allowed to own the drift tracking issue, comma separated (the drift cli)
# DRIFT_ISSUE_AUTHORS=
# Optional exporters, all no-ops when unset: page analytics on the index pages, errors, drift records (see the drift docs)
# UMAMI_URL=
# UMAMI_WEBSITE_ID=
# GLITCHTIP_DSN=
# OPENOBSERVE_URL=
# OPENOBSERVE_AUTH=
